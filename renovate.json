{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>junkerderprovinz/junkerderprovinz//renovate/base",
    "local>junkerderprovinz/junkerderprovinz//renovate/components"
  ],
  "packageRules": [
    {
      "description": "ArtCraft apps: one weekly PR for every new upstream release, reviewed and shipped with the next release",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "groupName": "ArtCraft apps",
      "commitMessageTopic": "ArtCraft apps",
      "commitMessagePrefix": "feat:",
      "labels": [
        "artcraft"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track each app version pinned in apps.json against the storytold/<app> GitHub releases",
      "managerFilePatterns": [
        "/^apps\\.json$/"
      ],
      "matchStrings": [
        "\"app\":\\s*\"(?<depName>[a-z]+)\",\\s*\"title\":\\s*\"[^\"]+\",\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "packageNameTemplate": "storytold/{{{depName}}}",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
